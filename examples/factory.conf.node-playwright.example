# Example factory.conf for a TypeScript web app with Docker Compose and Playwright. Replace ./run with your wrapper.
PROJECT_NAME=shop
REPO=/srv/shop
INTEGRATION_BRANCH=staging
PRODUCTION_BRANCH=main
PLAN_DIR=/srv/shop/plan
STACK_ENGINE=docker
STACK_MEM_GB=5
CMD_STACK_UP='docker compose -p "$FACTORY_STACK_NAME" up -d --wait'
CMD_STACK_DOWN='docker compose -p "$FACTORY_STACK_NAME" down -v --remove-orphans'
CMD_STACK_RESET='docker compose -p "$FACTORY_STACK_NAME" down -v --remove-orphans && docker compose -p "$FACTORY_STACK_NAME" up -d --wait && ./run seed'
CMD_GATE_FAST='./run lint && ./run typecheck && ./run test --changed'
CMD_GATE_FULL='./run lint && ./run typecheck && ./run test --coverage && ./run build && ./run audit'
CMD_E2E_TARGETED='./run e2e'
CMD_E2E_CRITICAL='./run e2e --grep @critical --retries=0 --reporter=json > e2e/report.json; python3 -I "$FACTORY_BIN"/verdict-from-playwright.py e2e/report.json "$1" e2e/critical-result.json'
E2E_VERDICT_FILE=e2e/critical-result.json
CMD_DEMO_REFRESH='./run demo'
CMD_POST_RELEASE_CHECK='curl -fsS https://shop.example.invalid/version | grep -q "$(git rev-parse HEAD)"'
CMD_CACHE_TRIM='docker builder prune -f --filter until=24h'
NOTIFY_CMD='/srv/shop/.factory/notify.sh'
DAILY_BUDGET_USD=150
