{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git add *)", "Bash(git commit *)",
      "Bash(git rebase *)", "Bash(git worktree add *)", "Bash(git branch --show-current)", "Bash(git rev-parse *)",
      "Bash(git push -u origin story/*:story/*)",
      "Bash(./run *)", "Bash(sh .factory/bin/heavy *)", "Bash(timeout *)", "Bash(grep *)", "Bash(sed *)", "Bash(tail *)", "Bash(head *)", "Bash(ls *)", "Bash(cat *)",
      "Read(*)", "Edit(*)", "Write(*)"
    ],
    "ask": [],
    "deny": [
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git push * --force*)", "Bash(git push * +*)",
      "Bash(git push * --no-verify*)", "Bash(git commit * --no-verify*)", "Bash(git commit --no-verify*)",
      "Bash(git push * main*)", "Bash(git push * staging*)", "Bash(git push --all*)", "Bash(git push --mirror*)",
      "Bash(git branch -f *)", "Bash(git branch -D main*)", "Bash(git switch main*)", "Bash(git checkout main*)",
      "Bash(git reset *)", "Bash(git restore *)", "Bash(git clean *)", "Bash(git -C *)", "Bash(git worktree remove *)",
      "Bash(git config *)", "Bash(rm -rf /*)", "Bash(rm -rf ~*)", "Bash(sudo *)",
      "Edit(.git/**)", "Write(.git/**)", "Edit(.githooks/**)", "Write(.githooks/**)",
      "Edit(.claude/settings*)", "Write(.claude/settings*)", "Edit(.github/workflows/**)", "Write(.github/workflows/**)",
      "Edit(.factory/bin/**)", "Write(.factory/bin/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-rails.sh" } ] }
    ]
  }
}
